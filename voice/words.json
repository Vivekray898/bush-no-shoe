  "duration_s": 67.1,
  "segments": [
    {
      "start": 0.0,
      "end": 4.68,
      "text": "A journalist threw a shoe at the President of the United States, and he missed twice."
    },
    {
      "start": 5.74,
      "end": 12.58,
      "text": "December 14, 2008, Baghdad, Iraq, President George W. Bush is at his last press conference"
    },
    {
      "start": 12.58,
      "end": 16.28,
      "text": "there, standing next to Iraq's Prime Minister, Neri Al-Maliki."
    },
    {
      "start": 17.18,
      "end": 20.74,
      "text": "A journalist in the front row, Mantadhar Alzady, stands up."
    },
    {
      "start": 21.08,
      "end": 25.24,
      "text": "He shouts, this is a farewell kiss from the Iraqi people you dog, and he throws"
    },
    {
      "start": 25.24,
      "end": 26.56,
      "text": "his shoe, Bush tux."
    },
    {
      "start": 27.66,
      "end": 29.34,
      "text": "Alzady throws his other shoe."
    },
    {
      "start": 29.34,
      "end": 32.48,
      "text": "This is for the widows and orphans, Bush tucks again."
    },
    {
      "start": 32.9,
      "end": 36.7,
      "text": "The second shoe flies past him and hits the American flag behind him."
    },
    {
      "start": 37.74,
      "end": 39.8,
      "text": "Luckily, Bush had fast reflexes."
    },
    {
      "start": 40.12,
      "end": 42.2,
      "text": "Unluckily for the shoe, it only hit a flag."
    },
    {
      "start": 43.58,
      "end": 47.06,
      "text": "A thrown shoe flies in a straight line, like a ball in dodgeball."
    },
    {
      "start": 47.4,
      "end": 50.34,
      "text": "If you drop down fast enough, it just sails over your head."
    },
    {
      "start": 51.58,
      "end": 53.82,
      "text": "Alzady was grabbed by guards and taken away."
    },
    {
      "start": 54.22,
      "end": 55.5,
      "text": "He was jailed for nine months."
    },
    {
      "start": 55.88,
      "end": 56.76,
      "text": "The shoes were destroyed."
    },
    {
      "start": 57.92,
      "end": 59.38,
      "text": "Bush just joked about it."
    },
    {
      "start": 59.7,
      "end": 62.52,
      "text": "If you want the facts, he said, it's a size 10 shoe."
    },
    {
      "start": 62.9,
      "end": 66.58,
      "text": "And the man who made that shoe, he suddenly got orders from all over the world."
    }
  ]
}