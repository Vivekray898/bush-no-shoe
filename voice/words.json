  "duration_s": 67.802,
  "segments": [
    {
      "start": 0.0,
      "end": 2.7,
      "text": "A journalist threw a shoe at the President of the United States."
    },
    {
      "start": 3.08,
      "end": 3.86,
      "text": "And he missed."
    },
    {
      "start": 4.3,
      "end": 4.58,
      "text": "Twice."
    },
    {
      "start": 5.34,
      "end": 6.98,
      "text": "December 14, 2008."
    },
    {
      "start": 7.7,
      "end": 8.7,
      "text": "Baghdad, Iraq."
    },
    {
      "start": 9.56,
      "end": 14.5,
      "text": "President George W. Bush is at his last press conference there, standing next to Iraq's"
    },
    {
      "start": 14.5,
      "end": 16.32,
      "text": "Prime Minister, Nouriel Maliki."
    },
    {
      "start": 17.0,
      "end": 20.44,
      "text": "A journalist in the front row, Muntadar Al-Zadeh, stands up."
    },
    {
      "start": 20.92,
      "end": 24.18,
      "text": "He shouts, this is a farewell kiss from the Iraqi people, you dog."
    },
    {
      "start": 24.68,
      "end": 25.68,
      "text": "And he throws his shoe."
    },
    {
      "start": 26.16,
      "end": 26.88,
      "text": "Bush ducks."
    },
    {
      "start": 27.38,
      "end": 28.6,
      "text": "Al-Zadeh throws his other shoe."
    },
    {
      "start": 28.6,
      "end": 30.7,
      "text": "This is for the widows and orphans."
    },
    {
      "start": 31.26,
      "end": 32.22,
      "text": "Bush ducks again."
    },
    {
      "start": 32.9,
      "end": 36.96,
      "text": "The second shoe flies past him and hits the American flag behind him."
    },
    {
      "start": 37.5,
      "end": 39.68,
      "text": "Luckily, Bush had fast reflexes."
    },
    {
      "start": 40.1,
      "end": 42.64,
      "text": "Unluckily for the shoe, it only hit a flag."
    },
    {
      "start": 43.3,
      "end": 47.18,
      "text": "A thrown shoe flies in a straight line, like a ball in dodgeball."
    },
    {
      "start": 47.8,
      "end": 50.72,
      "text": "If you drop down fast enough, it just sails over your head."
    },
    {
      "start": 51.54,
      "end": 53.58,
      "text": "Al-Zadeh was grabbed by guards and taken away."
    },
    {
      "start": 54.14,
      "end": 55.44,
      "text": "He was jailed for nine months."
    },
    {
      "start": 56.06,
      "end": 56.94,
      "text": "The shoes were destroyed."
    },
    {
      "start": 56.94,
      "end": 58.72,
      "text": "Bush just joked about it."
    },
    {
      "start": 59.48,
      "end": 62.8,
      "text": "If you want the fact, he said, it's a size 10 shoe."
    },
    {
      "start": 63.46,
      "end": 67.38,
      "text": "And the man who made that shoe, he suddenly got orders from all over the world."
    }
  ]
}